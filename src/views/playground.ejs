<div>
  <div class="content-header">
    <h1>💬 Playground</h1>
    <p>Chat with AI models and test their capabilities.</p>
  </div>

  <!-- Model Selector -->
  <div class="glass" style="max-width: 900px; margin-bottom: 24px;">
    <div class="glass-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
      <h2 style="font-size: 1.2rem; font-weight: 600;">Select Model</h2>
      <div class="filter-group" style="display:flex; align-items:center; gap:6px;">
        <label style="font-size:0.8rem;">Session name (optional):</label>
        <input type="text" id="sessionName" placeholder="e.g., my-chat" style="padding:6px 12px; background:rgba(255,255,255,0.7); border:1px solid var(--glass-border); border-radius:var(--radius-sm); font-size:0.8rem;">
      </div>
    </div>
    <div class="glass-body" style="padding-top:16px;">
      <div class="models-grid" style="grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));">
        <% models.forEach(m => { %>
          <div class="model-card" onclick="selectModel('<%= m.name %>')" id="modelCard_<%= m.name %>" style="cursor: pointer; margin-bottom: 8px;">
            <div class="model-header">
              <div class="model-icon" style="width: 36px; height: 36px; font-size: 16px;">⚡</div>
              <div class="model-info">
                <span class="model-name" style="font-size:0.85rem;">"<%= m.displayName %>"</span>
                <span class="model-provider" style="font-size:0.7rem; color: var(--text-muted);"><%= m.provider %></span>
              </div>
            </div>
            <div class="model-footer">
              <span class="model-price" style="font-size:0.75rem;"><%= m.price === 0 ? 'Free' : '$' + m.price + '/1K' %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Chat Area -->
  <div class="glass" style="max-width: 900px; height: 500px; display: flex; flex-direction: column;">
    <div class="glass-header" style="border-radius: var(--radius) var(--radius) 0 0;">
      <h2 style="font-size: 1rem; font-weight: 600;">Chat Window</h2>
    </div>
    <div class="glass-body" style="flex: 1; overflow-y: auto; padding: 16px;" id="chatContainer">
      <div id="chatMessages" style="display: flex; flex-direction: column; gap: 16px;">
        <div style="text-align: center; color: var(--text-muted); padding: 40px 20px;">
          <span style="font-size: 40px;">💬</span>
          <p style="margin-top: 8px;">Select a model and start chatting!</p>
        </div>
      </div>
    </div>
    <div class="glass-footer" style="padding: 16px 24px; border-radius: 0 0 var(--radius) var(--radius);">
      <div style="display: flex; gap: 12px; align-items: center;">
        <input type="text" id="chatInput" placeholder="Type your message..." style="flex: 1; padding: 12px 16px; background: rgba(255,255,255,0.7); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); font-size: 0.9rem;">
        <button class="btn btn-primary" onclick="sendMessage()" style="padding: 12px 24px;">Send</button>
      </div>
    </div>
  </div>
</div>

<script>
  let selectedModel = '<%= selectedModel %>';
  let sessionId = '<%= sessionId %>';

  function selectModel(modelName) {
    document.querySelectorAll('.model-card').forEach(c => c.classList.remove('selected'));
    document.getElementById('modelCard_' + modelName).classList.add('selected');
    selectedModel = modelName;
    showToast('Model selected: ' + modelName, 'info');
  }

  async function sendMessage() {
    const input = document.getElementById('chatInput');
    const message = input.value.trim();
    if (!message) return;

    const sessionName = document.getElementById('sessionName').value || null;
    if (sessionName) sessionId = sessionName;

    const chatContainer = document.getElementById('chatMessages');
    const messages = document.getElementById('chatMessages');

    // Add user message
    const userDiv = document.createElement('div');
    userDiv.style = 'align-self: flex-end; background: var(--primary-glow); backdrop-filter: blur(10px); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); padding: 12px 20px; max-width: 70%;';
    userDiv.innerHTML = '<strong>You</strong>: ' + message;
    messages.appendChild(userDiv);

    input.value = '';

    // Add assistant message (placeholder)
    const loadingDiv = document.createElement('div');
    loadingDiv.style = 'align-self: flex-start; display: flex; align-items: center; gap: 8px;';
    loadingDiv.innerHTML = '<span class="status-dot pulse" style="background: var(--primary);"></span><span>AI is typing...</span>';
    messages.appendChild(loadingDiv);
    messages.scrollTop = messages.scrollHeight;

    try {
      const res = await fetch('/playground/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ model: selectedModel, message, sessionId })
      });
      const data = await res.json();
      if (!res.ok) {
        loadingDiv.innerHTML = '<span style="color: #ef4444;">❌ Error: ' + (data.error || 'Failed to get response') + '</span>';
      } else {
        loadingDiv.innerHTML = '';
        const assistantDiv = document.createElement('div');
        assistantDiv.style = 'align-self: flex-start; background: rgba(255,255,255,0.5); backdrop-filter: blur(10px); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); padding: 12px 20px; max-width: 75%;';
        assistantDiv.innerHTML = '<strong>' + (data.model || 'AI') + '</strong>: ' + (data.response || 'No response');
        messages.appendChild(assistantDiv);
      }
    } catch (err) {
      loadingDiv.innerHTML = '<span style="color: #ef4444;">❌ Network error</span>';
    }
    messages.scrollTop = messages.scrollHeight;
  }

  // Allow Enter to send
  document.getElementById('chatInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });
</script>
